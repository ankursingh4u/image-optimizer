// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Shops that were already installed when code-managed billing enforcement was
/// switched on. These keep full access without a subscription — they installed
/// under a free app and shouldn't be locked out retroactively.
///
/// Populated once by scripts/backfill-grandfather.mjs from the Session table.
/// Absence of a row means "not grandfathered", so the backfill MUST run (and be
/// verified) before BILLING_ENFORCED is set to true.
model GrandfatheredShop {
  shop            String   @id
  grandfatheredAt DateTime @default(now())
  reason          String?
}

/// Per-shop, per-month tally of the operations that cost us money: AI alt text
/// generations, image compressions and PageSpeed runs. This is what makes the
/// plan limits real — without it the tiers differ on price alone and a Starter
/// shop can spend unbounded OpenAI credit.
///
/// `period` is a UTC "YYYY-MM" string rather than a date range: quotas reset on
/// the calendar month, which is simple to reason about and cheap to query. It
/// deliberately does NOT track the shop's billing cycle — aligning the two would
/// mean reading the cycle on every metered call.
model UsageCounter {
  shop      String
  metric    String
  period    String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([shop, metric, period])
  @@index([shop, period])
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
